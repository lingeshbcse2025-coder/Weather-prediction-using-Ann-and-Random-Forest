# WeatherAI India — backend configuration
# Copy to .env and adjust. Never commit .env.

# Comma-separated list of allowed browser origins for CORS.
WEATHERAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory containing the versioned model artifacts (default: ./artifacts).
WEATHERAI_ARTIFACTS_DIR=artifacts

# Which model version to serve. "latest" resolves via artifacts/LATEST.
WEATHERAI_MODEL_VERSION=latest

# Logging level for the API process.
WEATHERAI_LOG_LEVEL=INFO

# ---- Optional integrations ----
# Everything above this line is required. Everything below is optional: the
# app is fully functional (including the real ML prediction, which is the
# core product) with neither of these set. Each one only unlocks a specific
# additional feature, and degrades honestly (not fake output, see
# docs/FUNCTIONALITY_AUDIT.md) when absent.

# POST /api/ask (natural-language weather questions, "Will it rain tomorrow
# in Chennai?") ALWAYS works without this key (D-026): weatherai/api/agent.py
# is a small local, keyword-based query parser + template explanation
# generator that runs the same REAL prediction pipeline (trained on the
# repo's own data/processed/canonical.csv) with no network call of its own.
# Setting this key only upgrades the phrasing -- OpenAI then parses freer-
# form questions and writes a more varied explanation of the SAME verified
# result; it still never invents weather data or overrides the ML model.
# Get a key at platform.openai.com.
OPENAI_API_KEY=
# Model used for query parsing + explanation when OPENAI_API_KEY is set.
# gpt-4o-mini is the default: cheap and fast enough for both steps.
OPENAI_MODEL=gpt-4o-mini

# Enables the map's temperature/wind/clouds layers via OpenWeatherMap's free
# tile-layer product (richer, per-pixel tiles). Without this key, those
# layers still work in-app (D-025): they render real city-level markers built
# from a batched Open-Meteo request (weatherai/api/stations.py), no key
# needed at all. The precipitation radar layer never needs this key either --
# it already uses RainViewer's free public API. Get a free key at
# openweathermap.org/api.
MAP_API_KEY=

# Enables general current-events headlines (not just disaster alerts) in the
# News & Alerts panel via newsapi.org. Without this key, GET /api/news still
# returns real, live disaster/weather alerts for India (GDACS, public domain,
# no key needed at all) -- only the broader "news" list is empty, with
# `news_available: false` so the frontend can say so honestly. Google News'
# RSS was deliberately NOT used as a keyless alternative: its own feed states
# it's for "personal, non-commercial" feed-reader use only (D-024). Get a
# free key at newsapi.org.
NEWS_API_KEY=
